    "isArchived": false,
    "nodes": [
        {
            "id": "webhook-001",
            "name": "Crawl Trigger",
            "type": "n8n-nodes-base.webhook",
            "position": [
                100,
                300
            ],
            "typeVersion": 2,
            "webhookId": "crawl-gmail-cef88fff",
            "parameters": {
                "httpMethod": "POST",
                "path": "crawl-gmail-receipts",
                "responseMode": "responseNode",
                "options": {}
            }
        },
        {
            "id": "code-build-query-001",
            "name": "Build Search Query",
            "type": "n8n-nodes-base.code",
            "position": [
                320,
                300
            ],
            "typeVersion": 2,
            "parameters": {
                "jsCode": "\nconst body  = $input.first().json.body || {};\nconst period = body.period || 'month';\nconst limit  = body.limit  || 100;\n\n// Explicit date overrides\nlet afterDate  = body.after  ? String(body.after).replace(/-/g, '/')  : null;\nlet beforeDate = body.before ? String(body.before).replace(/-/g, '/') : null;\n\nif (!afterDate) {\n  const now = new Date();\n  switch (period) {\n    case 'day':\n      afterDate = now.toISOString().slice(0, 10).replace(/-/g, '/');\n      break;\n    case 'week': {\n      const d = new Date(now - 7 * 86400000);\n      afterDate = d.toISOString().slice(0, 10).replace(/-/g, '/');\n      break;\n    }\n    case 'month':\n      afterDate = `${now.getFullYear()}/${String(now.getMonth() + 1).padStart(2, '0')}/01`;\n      break;\n    case 'year':\n    default:\n      afterDate = `${now.getFullYear()}/01/01`;\n  }\n}\n\nconst keywords = '(receipt OR invoice OR \"order confirmation\" OR \"payment confirmation\" OR \"your purchase\" OR \"order placed\" OR \"order receipt\" OR \"payment received\")';\nlet q = `has:attachment ${keywords} -label:Receipts after:${afterDate}`;\nif (beforeDate) q += ` before:${beforeDate}`;\n\nreturn [{ json: { query: q, period, afterDate, beforeDate, limit } }];\n"
            }
        },
        {
            "id": "gmail-getall-001",
            "name": "Search Gmail",
            "type": "n8n-nodes-base.gmail",
            "position": [
                560,
                300
            ],
            "typeVersion": 2.1,
            "credentials": {
                "gmailOAuth2": {
                    "id": "cZIfyQPNke8rIHal",
                    "name": "Gmail account"
                }
            },
            "parameters": {
                "operation": "getAll",
                "returnAll": false,
                "limit": "={{ $json.limit }}",
                "filters": {
                    "q": "={{ $json.query }}"
                },
                "options": {}
            }
        },
        {
            "id": "split-batches-001",
            "name": "For Each Email",
            "type": "n8n-nodes-base.splitInBatches",
            "position": [
                800,
                300
            ],
            "typeVersion": 3,
            "parameters": {
                "batchSize": 1,
                "options": {}
            }
        },
        {
            "id": "gmail-get-001",
            "name": "Get Message & Attachments",
            "type": "n8n-nodes-base.gmail",
            "position": [
                1040,
                300
            ],
            "typeVersion": 2.1,
            "credentials": {
                "gmailOAuth2": {
                    "id": "cZIfyQPNke8rIHal",
                    "name": "Gmail account"
                }
            },
            "parameters": {
                "operation": "get",
                "messageId": "={{ $json.id }}",
                "options": {
                    "downloadAttachments": true,
                    "dataPropertyAttachmentsPrefixName": "attachment"
                }
            }
        },
        {
            "id": "code-split-att-001",
            "name": "Split Attachments",
            "type": "n8n-nodes-base.code",
            "position": [
                1280,
                300
            ],
            "typeVersion": 2,
            "parameters": {
                "jsCode": "\nconst outputItems = [];\n\nfor (const item of $input.all()) {\n  const binary = item.binary || {};\n  const { id, subject = '(no subject)', date, from } = item.json || {};\n\n  for (const [key, bin] of Object.entries(binary)) {\n    const mime = (bin.mimeType || '').toLowerCase();\n    const isReceiptAttachment =\n      mime.includes('pdf') ||\n      mime.startsWith('image/') ||\n      mime.includes('jpeg') ||\n      mime.includes('png');\n\n    if (isReceiptAttachment) {\n      outputItems.push({\n        json: {\n          emailId: id,\n          subject,\n          date,\n          from,\n          fileName: bin.fileName || `receipt_${Date.now()}.pdf`,\n          mimeType: mime\n        },\n        binary: { file: bin }   // normalise to single key \"file\"\n      });\n    }\n  }\n}\n\n// Return sentinel so the loop still advances when no valid attachments found\nreturn outputItems.length > 0\n  ? outputItems\n  : [{ json: { skip: true } }];\n"
            }
        },
        {
            "id": "if-has-att-001",
            "name": "Has Receipt Attachment?",
            "type": "n8n-nodes-base.if",
            "position": [
